        // === PURE JS IFC/STEP PARSER (no WASM dependency) ===
        function parseIfcFile(arrayBuffer) {
            const decoder = new TextDecoder('utf-8');
            const text = decoder.decode(new Uint8Array(arrayBuffer));
            const lines = text.split(/\r?\n/);

            // Pass 1: index all entities by #ID and type
            const entityMap = {}; // id -> { type, args (raw string) }
            const entitiesByType = {}; // TYPE -> [id, id, ...]
            const linePattern = /^#(\d+)\s*=\s*([A-Z][A-Z0-9_]*)\s*\((.*)\)\s*;\s*$/;

            for (const line of lines) {
                const trimmed = line.trim();
                const m = trimmed.match(linePattern);
                if (!m) continue;
                const id = parseInt(m[1]);
                const type = m[2].toUpperCase();
                const args = m[3];
                entityMap[id] = { type, args };
                if (!entitiesByType[type]) entitiesByType[type] = [];
                entitiesByType[type].push(id);
            }

            // Helper: extract #refs from a raw argument string
            function extractRefs(argStr) {
                const refs = [];
                const re = /#(\d+)/g;
                let match;
                while ((match = re.exec(argStr)) !== null) {
                    refs.push(parseInt(match[1]));
                }
                return refs;
            }

            // Helper: split top-level STEP arguments (respects nested parens)
            function splitArgs(argStr) {
                const result = [];
                let depth = 0, current = '', inStr = false;
                for (let i = 0; i < argStr.length; i++) {
                    const c = argStr[i];
                    if (c === "'" && !inStr) { inStr = true; current += c; continue; }
                    if (c === "'" && inStr) { inStr = false; current += c; continue; }
                    if (inStr) { current += c; continue; }
                    if (c === '(') { depth++; current += c; continue; }
                    if (c === ')') { depth--; current += c; continue; }
                    if (c === ',' && depth === 0) { result.push(current.trim()); current = ''; continue; }
                    current += c;
                }
                if (current.trim()) result.push(current.trim());
                return result;
            }

            // Pass 2: Build per-element property-set NAMES and document association NAMES
            // We track unique names so we count distinct requirements, not instance-level sums
            const elemPsetNames = {};  // elementId -> Set of pset name strings
            const elemDocNames = {};   // elementId -> Set of doc reference strings

            const relDefProps = (entitiesByType['IFCRELDEFINESBYPROPERTIES'] || []);
            for (const relId of relDefProps) {
                const ent = entityMap[relId];
                if (!ent) continue;
                const args = splitArgs(ent.args);
                const relatedRefs = extractRefs(args[4] || '');
                // Get the pset definition ref and resolve its name
                const psetRefs = extractRefs(args[5] || '');
                let psetName = 'pset_' + relId; // fallback unique key
                if (psetRefs.length > 0 && entityMap[psetRefs[0]]) {
                    const psetEnt = entityMap[psetRefs[0]];
                    const psetArgs = splitArgs(psetEnt.args);
                    if (psetArgs.length > 2 && psetArgs[2] !== '$') {
                        psetName = psetArgs[2].replace(/'/g, '');
                    }
                }
                for (const ref of relatedRefs) {
                    if (!elemPsetNames[ref]) elemPsetNames[ref] = new Set();
                    elemPsetNames[ref].add(psetName);
                }
            }

            const relAssocDoc = (entitiesByType['IFCRELASSOCIATESDOCUMENT'] || []);
            for (const relId of relAssocDoc) {
                const ent = entityMap[relId];
                if (!ent) continue;
                const args = splitArgs(ent.args);
                const relatedRefs = extractRefs(args[4] || '');
                const docRefs = extractRefs(args[5] || '');
                let docName = 'doc_' + relId;
                if (docRefs.length > 0 && entityMap[docRefs[0]]) {
                    const docEnt = entityMap[docRefs[0]];
                    const docArgs = splitArgs(docEnt.args);
                    if (docArgs.length > 2 && docArgs[2] !== '$') {
                        docName = docArgs[2].replace(/'/g, '');
                    }
                }
                for (const ref of relatedRefs) {
                    if (!elemDocNames[ref]) elemDocNames[ref] = new Set();
                    elemDocNames[ref].add(docName);
                }
            }

            // Pass 3: iterate product entities, classify G/A/D
            // We track TWO levels:
            //   Instance-level sums: totalGeom/Props/Docs across all instances (for total score / components)
            //   Type-level uniques: unique pset names per type (for density / intensity)
            const objectStats = {};  // bimidsName -> {geomInstances, propInstanceSum, docInstanceSum, psetNames: Set, docNames: Set, count}
            let unmappedCount = 0;
            const unmappedTypes = {};
            const productTypes = Object.keys(IFC_ENTITY_MAP);

            for (const ifcType of productTypes) {
                const ids = entitiesByType[ifcType] || [];
                if (ids.length === 0) continue;
                const bimidsName = IFC_ENTITY_MAP[ifcType];

                for (const id of ids) {
                    const ent = entityMap[id];
                    if (!ent) continue;

                    // Geometry detection
                    let hasGeom = false;
                    const allRefs = extractRefs(ent.args);
                    for (const ref of allRefs) {
                        const refEnt = entityMap[ref];
                        if (!refEnt) continue;
                        const rt = refEnt.type;
                        if (rt === 'IFCPRODUCTDEFINITIONSHAPE' || rt === 'IFCSHAPEREPRESENTATION' ||
                            rt === 'IFCMATERIALDEFINITIONREPRESENTATION') {
                            hasGeom = true;
                            break;
                        }
                    }
                    if (!hasGeom) {
                        const args = splitArgs(ent.args);
                        if (args.length > 6 && args[6] && args[6] !== '$') hasGeom = true;
                    }

                    const elemPsets = elemPsetNames[id];
                    const elemDocs = elemDocNames[id];
                    const instancePropCount = elemPsets ? elemPsets.size : 0;
                    const instanceDocCount = elemDocs ? elemDocs.size : 0;

                    if (bimidsName) {
                        if (!objectStats[bimidsName]) {
                            objectStats[bimidsName] = {
                                geomInstances: 0, propInstanceSum: 0, docInstanceSum: 0,
                                psetNames: new Set(), docNames: new Set(), count: 0
                            };
                        }
                        objectStats[bimidsName].count++;
                        if (hasGeom) objectStats[bimidsName].geomInstances++;
                        objectStats[bimidsName].propInstanceSum += instancePropCount;
                        objectStats[bimidsName].docInstanceSum += instanceDocCount;
                        // Type-level unique names (for density)
                        if (elemPsets) elemPsets.forEach(n => objectStats[bimidsName].psetNames.add(n));
                        if (elemDocs) elemDocs.forEach(n => objectStats[bimidsName].docNames.add(n));
                    } else if (bimidsName === null) {
                        unmappedCount++;
                        unmappedTypes[ifcType] = (unmappedTypes[ifcType] || 0) + 1;
                    }
                }
            }

            // Build results
            // Totals use instance-level sums (volume of information in the model)
            // Density/intensity use type-level unique counts (richness of specification per class)
            let totalGeom = 0, totalProps = 0, totalDocs = 0;
            const objectKPIs = [];
            for (const [name, stats] of Object.entries(objectStats)) {
                // Instance-level for totals
                totalGeom += stats.geomInstances;
                totalProps += stats.propInstanceSum;
                totalDocs += stats.docInstanceSum;
                // Type-level for intensity/density
                const typeG = stats.geomInstances > 0 ? 1 : 0;
                const typeA = stats.psetNames.size;
                const typeD = stats.docNames.size;
                const typeReqs = typeG + typeA + typeD;
                const instanceTotal = stats.geomInstances + stats.propInstanceSum + stats.docInstanceSum;
                objectKPIs.push({
                    name, count: stats.count,
                    reqs: instanceTotal,
                    geom: stats.geomInstances, props: stats.propInstanceSum, docs: stats.docInstanceSum,
                    intensity: typeReqs,
                    compG: instanceTotal > 0 ? Math.round((stats.geomInstances / instanceTotal) * 1000) / 10 : 0,
                    compA: instanceTotal > 0 ? Math.round((stats.propInstanceSum / instanceTotal) * 1000) / 10 : 0,
                });
            }
            objectKPIs.sort((a, b) => b.intensity - a.intensity);
            const totalScore = totalGeom + totalProps + totalDocs;
            const objectCount = Object.keys(objectStats).length;
            // Density = average type-level unique reqs per object type
            const densitySum = objectKPIs.reduce((s, o) => s + o.intensity, 0);
            const density = objectCount > 0 ? Math.round((densitySum / objectCount) * 100) / 100 : 0;

            // Normalised totals (one instance per type, like BIMids)
            let normGeom = 0, normProps = 0, normDocs = 0;
            for (const [name, stats] of Object.entries(objectStats)) {
                normGeom += stats.geomInstances > 0 ? 1 : 0;
                normProps += stats.psetNames.size;
                normDocs += stats.docNames.size;
            }
            const normScore = normGeom + normProps + normDocs;

            return {
                totalGeom, totalProps, totalDocs, totalScore,
                normGeom, normProps, normDocs, normScore,
                density, objectCount, objectKPIs,
                unmappedCount, unmappedTypes,
                entityTotal: Object.values(objectStats).reduce((s, o) => s + o.count, 0) + unmappedCount
            };
        }

        async function handleIfcUpload(file) {
            const statusEl = document.getElementById('ifc-status');
            if (statusEl) { statusEl.className = 'ifc-status parsing'; statusEl.textContent = '⏳ Reading IFC file...'; statusEl.style.display = 'block'; }

            try {
                const buffer = await file.arrayBuffer();
                if (statusEl) { statusEl.textContent = '⏳ Parsing ' + file.name + ' (' + (buffer.byteLength / 1024 / 1024).toFixed(1) + ' MB)...'; }
                const result = await parseIfcFile(buffer);
                ifcData = { fileName: file.name, ...result };
                if (statusEl) { statusEl.className = 'ifc-status done'; statusEl.textContent = '✓ ' + file.name + ' — ' + ifcData.entityTotal + ' entities, ' + ifcData.objectCount + ' object types'; }
                render();
            } catch (err) {
                console.error('IFC parse error:', err);
                if (statusEl) { statusEl.className = 'ifc-status error'; statusEl.textContent = '✗ Error: ' + (err.message || err); statusEl.style.display = 'block'; }
            }
        }

        function clearIfc() {
            ifcData = null;
            const statusEl = document.getElementById('ifc-status');
            if (statusEl) { statusEl.style.display = 'none'; }
            render();
        }
        let selected = [];
        let selectionOrder = [];
        
        function calculateMetrics() {
            if (selected.length === 0) return {totalScore:0, totalGeom:0, totalProps:0, totalDocs:0, avgDensity:0, totalObjects:0, phases:[0,0,0,0,0]};
            const cases = USE_CASES.filter(uc => selected.includes(uc.name));
            const totalScore = cases.reduce((s, uc) => s + uc.score, 0);
            const totalGeom = cases.reduce((s, uc) => s + uc.geom, 0);
            const totalProps = cases.reduce((s, uc) => s + uc.props, 0);
            const totalDocs = cases.reduce((s, uc) => s + uc.docs, 0);
            const avgDensity = cases.reduce((s, uc) => s + uc.density, 0) / cases.length;
            const totalObjects = Math.max(...cases.map(uc => uc.objects));
            const phases = [0,0,0,0,0];
            if (totalScore > 0) {
                cases.forEach(uc => {
                    if (uc.score > 0) {
                        const w = uc.score / totalScore;
                        for (let i=0; i<5; i++) phases[i] += uc['p'+(i+1)] * w;
                    }
                });
            }
            return {
                totalScore: Math.round(totalScore*10)/10,
                totalGeom, totalProps, totalDocs,
                avgDensity: Math.round(avgDensity*100)/100,
                totalObjects,
                phases: phases.map(p => Math.round(p*1000)/10)
            };
        }
        
        function getObjectKPIs() {
            if (selected.length === 0) {
                return [];  // No selection, no objects
            }
            
            // Filter to objects that appear in selected purposes
            const relevantObjects = OBJECTS.filter(obj => {
                const objPurposes = OBJECT_PURPOSE_MAP[obj.name] || [];
                // Check if any selected purpose uses this object
                return selected.some(selPurpose => objPurposes.includes(selPurpose));
            });
            
            // Sort by intensity and return top 5
            return relevantObjects.sort((a,b) => b.intensity - a.intensity);
        }
        
        function getTier(m) {
            if (m >= 40) return {label:'Top Tier'};
            if (m >= 25) return {label:'High'};
            if (m >= 15) return {label:'Moderate'};
            if (m >= 5) return {label:'Low'};
            return {label:'Minimal'};
        }
        
        function toggle(name) {
            const idx = selected.indexOf(name);
            if (idx >= 0) {
                selected.splice(idx, 1);
                const o = selectionOrder.indexOf(name);
                if (o >= 0) selectionOrder.splice(o, 1);
            } else {
                selected.push(name);
                selectionOrder.push(name);
            }
            render();
        }
        
        function reset() { selected = []; selectionOrder = []; render(); }
        function selectMinPlusTop7() {
            const top7 = Object.entries(INCREMENTAL).sort((a,b) => b[1].marginal - a[1].marginal).slice(0,7).map(([n]) => n);
            selected = ['Minimum requirements', ...top7];
            selectionOrder = [...selected];
            render();
        }
        
        function render() {
            const m = calculateMetrics();
            const app = document.getElementById('app');
            const minReq = USE_CASES.find(uc => uc.name === 'Minimum requirements');
            const others = USE_CASES.filter(uc => uc.name !== 'Minimum requirements').sort((a,b) => (INCREMENTAL[b.name]?.marginal||0) - (INCREMENTAL[a.name]?.marginal||0));
            let sidebar = `<h2>📋 Use Cases (${selected.length}/22)</h2><div class="quick-actions"><button class="btn btn-reset" onclick="reset()">Reset</button><button class="btn btn-quick" onclick="selectMinPlusTop7()">Min + Top 7</button></div>`;
            // IFC Upload area
            sidebar += `<div class="divider"></div>`;
            sidebar += `<div class="section-header">IFC Model Upload</div>`;
            sidebar += `<div id="ifc-status" class="ifc-status" style="display:${ifcData ? 'block' : 'none'}"${ifcData ? ` class="ifc-status done"` : ''}>${ifcData ? '✓ ' + ifcData.fileName + ' — ' + ifcData.entityTotal + ' entities, ' + ifcData.objectCount + ' object types' : ''}</div>`;
            sidebar += `<div class="ifc-upload-area ${ifcData ? 'loaded' : ''}" id="ifc-drop-zone" onclick="document.getElementById('ifc-file-input').click()">`;
            sidebar += `<div class="ifc-upload-icon">${ifcData ? '📦' : '📁'}</div>`;
            sidebar += `<div class="ifc-upload-text">${ifcData ? ifcData.fileName : 'Drop .ifc file or click to browse'}</div>`;
            if (ifcData) sidebar += `<button class="ifc-clear-btn" onclick="event.stopPropagation(); clearIfc();">Remove</button>`;
            sidebar += `</div>`;
            sidebar += `<input type="file" id="ifc-file-input" accept=".ifc" style="display:none">`;
            sidebar += `<div class="divider"></div>`;
            const minS = selected.includes(minReq.name);
            const minO = selectionOrder.indexOf(minReq.name)+1;
            sidebar += `<div class="use-case-card baseline ${minS?'selected':''}" onclick="toggle('${minReq.name}')"><div class="card-header"><input type="checkbox" ${minS?'checked':''}><div class="card-name">${minO>0?`#${minO} `:''}${minReq.name}</div><div class="card-score">${minReq.score}</div></div></div><div class="divider"></div>`;
            let lastT = null;
            others.forEach(uc => {
                const inc = INCREMENTAL[uc.name]||{marginal:0,unique:0};
                const t = getTier(inc.marginal);
                const isSel = selected.includes(uc.name);
                const ord = selectionOrder.indexOf(uc.name)+1;
                if (t.label !== lastT) {
                    sidebar += `<div class="section-header">${t.label}</div>`;
                    lastT = t.label;
                }
                sidebar += `<div class="use-case-card ${isSel?'selected':''}" onclick="toggle('${uc.name.replace(/'/g,"\\'")}')"><div class="card-header"><input type="checkbox" ${isSel?'checked':''}><div class="card-name">${ord>0?`#${ord} `:''}${uc.name}</div><div class="card-score">${uc.score}</div></div>${!isSel?`<div class="card-meta">+${inc.marginal} | ${inc.unique}% unique</div>`:''}</div>`;
            });
            let content = '';
            if (selected.length === 0 && !ifcData) {
                content = '<div class="empty-state">Select use cases or upload an IFC file to begin</div>';
            } else {
                // === BIMids metrics (if any selected) ===
                if (selected.length > 0) {
                content = `<div class="metrics"><div class="metric"><div class="metric-label">Total Information Score</div><div class="metric-value">${m.totalScore.toLocaleString()}</div><div class="metric-sub">${selected.length} cases</div></div><div class="metric"><div class="metric-label">Information Density</div><div class="metric-value">${m.avgDensity}</div><div class="metric-sub">reqs/object</div></div><div class="metric"><div class="metric-label">Total Components</div><div class="metric-value">${(m.totalGeom+m.totalProps+m.totalDocs).toLocaleString()}</div><div class="metric-sub">G:${m.totalGeom} A:${m.totalProps} D:${m.totalDocs}</div></div><div class="metric"><div class="metric-label">Object Coverage</div><div class="metric-value">${m.totalObjects}</div><div class="metric-sub">objects</div></div></div>`;
                }

                // === COMPARISON VIEW (BIMids + IFC side by side) ===
                // BIMids already counts 1 instance per type; IFC uses normScore for the same basis
                // G/A/D compared as percentages only
                if (ifcData && selected.length > 0) {
                    const bTotal = m.totalGeom + m.totalProps + m.totalDocs;
                    const iNorm = ifcData.normScore;
                    const maxScore = Math.max(bTotal, iNorm, 1);
                    const bGpct = bTotal > 0 ? (m.totalGeom/bTotal*100).toFixed(1) : '0.0';
                    const bApct = bTotal > 0 ? (m.totalProps/bTotal*100).toFixed(1) : '0.0';
                    const bDpct = bTotal > 0 ? (m.totalDocs/bTotal*100).toFixed(1) : '0.0';
                    const iGpct = iNorm > 0 ? (ifcData.normGeom/iNorm*100).toFixed(1) : '0.0';
                    const iApct = iNorm > 0 ? (ifcData.normProps/iNorm*100).toFixed(1) : '0.0';
                    const iDpct = iNorm > 0 ? (ifcData.normDocs/iNorm*100).toFixed(1) : '0.0';

                    content += `<div style="margin-bottom:20px;"><div class="chart-title" style="font-size:18px;">🔄 BIMids vs IFC Comparison</div></div>`;
                    content += `<div class="comparison-grid">`;
                    // BIMids panel
                    content += `<div class="comparison-panel bimids-panel">`;
                    content += `<div class="comparison-panel-title"><span class="dot dot-bimids"></span> BIMids Selection (${selected.length} cases)</div>`;
                    content += `<div class="comp-metric"><span class="comp-metric-label">Score</span><span class="comp-metric-value">${bTotal.toLocaleString()}</span></div>`;
                    content += `<div class="comp-bar"><div class="comp-bar-fill" style="width:${(bTotal/maxScore*100)}%; background:#667eea;"></div></div>`;
                    content += `<div class="comp-metric"><span class="comp-metric-label">G / A / D split</span><span class="comp-metric-value">${bGpct}% / ${bApct}% / ${bDpct}%</span></div>`;
                    content += `<div class="comp-metric"><span class="comp-metric-label">Object Types</span><span class="comp-metric-value">${m.totalObjects}</span></div>`;
                    content += `<div class="comp-metric"><span class="comp-metric-label">Density</span><span class="comp-metric-value">${m.avgDensity} reqs/type</span></div>`;
                    content += `</div>`;
                    // IFC panel
                    content += `<div class="comparison-panel ifc-panel">`;
                    content += `<div class="comparison-panel-title"><span class="dot dot-ifc"></span> IFC: ${ifcData.fileName}</div>`;
                    content += `<div class="comp-metric"><span class="comp-metric-label">Score</span><span class="comp-metric-value">${iNorm.toLocaleString()}</span></div>`;
                    content += `<div class="comp-bar"><div class="comp-bar-fill" style="width:${(iNorm/maxScore*100)}%; background:#27ae60;"></div></div>`;
                    content += `<div class="comp-metric"><span class="comp-metric-label">G / A / D split</span><span class="comp-metric-value">${iGpct}% / ${iApct}% / ${iDpct}%</span></div>`;
                    content += `<div class="comp-metric"><span class="comp-metric-label">Object Types</span><span class="comp-metric-value">${ifcData.objectCount}</span></div>`;
                    content += `<div class="comp-metric"><span class="comp-metric-label">Density</span><span class="comp-metric-value">${ifcData.density} reqs/type</span></div>`;
                    if (ifcData.unmappedCount > 0) {
                        content += `<div class="comp-metric"><span class="comp-metric-label" style="color:#e67e22;">Unmapped</span><span class="comp-metric-value" style="color:#e67e22;">${ifcData.unmappedCount} entities</span></div>`;
                    }
                    content += `</div>`;
                    content += `</div>`; // end comparison-grid

                    // Chart: G/A/D percentage comparison + phase chart
                    content += `<div class="charts"><div class="chart-box"><div class="chart-title">G / A / D Split (%)</div><div class="chart-canvas"><canvas id="compCompareChart"></canvas></div></div><div class="chart-box"><div class="chart-title">Phase Allocation (BIMids only)</div><div class="chart-canvas"><canvas id="phaseChart"></canvas></div></div></div>`;
                }
                // === IFC-ONLY VIEW (no BIMids selected) ===
                else if (ifcData && selected.length === 0) {
                    const iTotal = ifcData.totalScore;
                    const iGpct = iTotal > 0 ? (ifcData.totalGeom/iTotal*100).toFixed(1) : '0.0';
                    const iApct = iTotal > 0 ? (ifcData.totalProps/iTotal*100).toFixed(1) : '0.0';
                    const iDpct = iTotal > 0 ? (ifcData.totalDocs/iTotal*100).toFixed(1) : '0.0';
                    content = `<div class="metrics"><div class="metric" style="background:linear-gradient(135deg,#27ae60,#2ecc71);"><div class="metric-label">Total Information Score</div><div class="metric-value">${iTotal.toLocaleString()}</div><div class="metric-sub">${ifcData.fileName}</div></div><div class="metric" style="background:linear-gradient(135deg,#27ae60,#2ecc71);"><div class="metric-label">Information Density</div><div class="metric-value">${ifcData.density}</div><div class="metric-sub">unique reqs/type</div></div><div class="metric" style="background:linear-gradient(135deg,#27ae60,#2ecc71);"><div class="metric-label">Total Components</div><div class="metric-value">${iTotal.toLocaleString()}</div><div class="metric-sub">G:${ifcData.totalGeom.toLocaleString()} A:${ifcData.totalProps.toLocaleString()} D:${ifcData.totalDocs.toLocaleString()}</div></div><div class="metric" style="background:linear-gradient(135deg,#27ae60,#2ecc71);"><div class="metric-label">Object Types</div><div class="metric-value">${ifcData.objectCount}</div><div class="metric-sub">${ifcData.entityTotal} entities total</div></div></div>`;
                    content += `<div class="charts"><div class="chart-box"><div class="chart-title">IFC G / A / D Split (%)</div><div class="chart-canvas"><canvas id="ifcOnlyCompChart"></canvas></div></div><div class="chart-box"><div class="chart-title">Entity Counts by Object Type (Top 15)</div><div class="chart-canvas"><canvas id="ifcObjectBarChart"></canvas></div></div></div>`;
                }
                // === BIMids-ONLY VIEW (original) ===
                else if (selected.length > 0 && !ifcData) {
                content += `<div class="charts"><div class="chart-box"><div class="chart-title">Component Distribution Percentages</div><div class="chart-canvas"><canvas id="compChart"></canvas></div></div><div class="chart-box"><div class="chart-title">Phase Allocation Ratios</div><div class="chart-canvas"><canvas id="phaseChart"></canvas></div></div></div>`;
                }

                // Recommendations table
                if (selected.length > 0) {
                const uns = USE_CASES.filter(uc => !selected.includes(uc.name));

                if (ifcData) {
                    // === IFC-AWARE USE CASE MATCHING ===
                    // Two dimensions:
                    //   1. Type coverage: does this UC add new IFC object types?
                    //   2. Object improvement: for "Under" objects, does this UC improve intensity?
                    const ifcObjectNames = new Set(ifcData.objectKPIs.map(o => o.name));
                    const ifcByName = {}; // name -> ifcData KPI
                    ifcData.objectKPIs.forEach(o => { ifcByName[o.name] = o; });
                    const ifcNormTotal = ifcData.normScore || 1;
                    const ifcGpct = ifcData.normGeom / ifcNormTotal;
                    const ifcApct = ifcData.normProps / ifcNormTotal;
                    const ifcDpct = ifcData.normDocs / ifcNormTotal;

                    // Which IFC types are already covered by the current selection?
                    const coveredBySelection = new Set();
                    for (const [objName, purposes] of Object.entries(OBJECT_PURPOSE_MAP)) {
                        if (ifcObjectNames.has(objName) && purposes.some(p => selected.includes(p))) {
                            coveredBySelection.add(objName);
                        }
                    }
                    const uncoveredIfc = [...ifcObjectNames].filter(o => !coveredBySelection.has(o));
                    const allTypesCovered = uncoveredIfc.length === 0;

                    // For covered objects, compute current IDS intensity to find "Under" objects
                    const currentIdsIntensity = {}; // objName -> BIMids intensity from current selection
                    const objK = getObjectKPIs();
                    objK.forEach(o => { currentIdsIntensity[o.name] = o.intensity; });

                    // Objects that are in both IFC and current IDS but where IFC > IDS (under-specified)
                    const underObjects = [...coveredBySelection].filter(objName => {
                        const ifcInt = ifcByName[objName]?.intensity || 0;
                        const idsInt = currentIdsIntensity[objName] || 0;
                        return ifcInt - idsInt > 1; // IFC has more than IDS asks for
                    });

                    const allObjectsOk = allTypesCovered && underObjects.length === 0;

                    const matches = uns.map(uc => {
                        const ucObjects = new Set();
                        for (const [objName, purposes] of Object.entries(OBJECT_PURPOSE_MAP)) {
                            if (purposes.includes(uc.name)) ucObjects.add(objName);
                        }
                        // NEW IFC types this UC would add
                        const coversIfcTypes = [...ifcObjectNames].filter(o => ucObjects.has(o));
                        const newIfcTypes = coversIfcTypes.filter(o => !coveredBySelection.has(o));

                        // How many "Under" objects would this UC improve?
                        // An Under object improves if this UC includes it (adding more purposes increases BIMids intensity)
                        const improvesUnder = underObjects.filter(objName => ucObjects.has(objName));

                        // G/A/D similarity (cosine)
                        const ucTotal = uc.score || 1;
                        const ucGpct = uc.geom / ucTotal;
                        const ucApct = uc.props / ucTotal;
                        const ucDpct = uc.docs / ucTotal;
                        const dot = ucGpct*ifcGpct + ucApct*ifcApct + ucDpct*ifcDpct;
                        const magUC = Math.sqrt(ucGpct**2 + ucApct**2 + ucDpct**2) || 1;
                        const magIFC = Math.sqrt(ifcGpct**2 + ifcApct**2 + ifcDpct**2) || 1;
                        const gadSim = Math.round(dot / (magUC * magIFC) * 100);

                        return {
                            name: uc.name, score: uc.score,
                            coversCount: coversIfcTypes.length,
                            newCount: newIfcTypes.length,
                            newTypes: newIfcTypes,
                            improvesCount: improvesUnder.length,
                            improvesNames: improvesUnder,
                            ucObjCount: ucObjects.size,
                            gadSim
                        };
                    }).sort((a, b) => {
                        // Priority 1: UCs that add new uncovered IFC types
                        if (!allTypesCovered && (b.newCount !== a.newCount)) return b.newCount - a.newCount;
                        // Priority 2: UCs that improve Under objects
                        if (underObjects.length > 0 && (b.improvesCount !== a.improvesCount)) return b.improvesCount - a.improvesCount;
                        // Priority 3: G/A/D match
                        return b.gadSim - a.gadSim;
                    });

                    // Status summary
                    let statusParts = [];
                    if (!allTypesCovered) {
                        statusParts.push('<span style="color:#e65100;font-weight:600;">Types: ' + coveredBySelection.size + '/' + ifcObjectNames.size + ' covered — remaining: ' + uncoveredIfc.join(', ') + '</span>');
                    } else {
                        statusParts.push('<span style="color:#2e7d32;font-weight:600;">✓ All ' + ifcObjectNames.size + ' IFC types covered</span>');
                    }
                    if (underObjects.length > 0) {
                        statusParts.push('<span style="color:#e65100;font-weight:600;">Objects: ' + underObjects.length + ' under-specified (' + underObjects.join(', ') + ')</span>');
                    } else if (allTypesCovered) {
                        statusParts.push('<span style="color:#2e7d32;font-weight:600;">✓ All objects adequately specified</span>');
                    }

                    content += '<div style="margin-top:30px;"><div class="chart-title">Use Case Relevance to IFC Model</div>';
                    content += '<div style="font-size:11px;margin-bottom:10px;">' + statusParts.join(' &nbsp;|&nbsp; ') + '</div>';
                    content += '<table class="rec-table"><thead><tr>';
                    content += '<th>Use Case</th>';
                    if (!allTypesCovered) {
                        content += '<th style="text-align:center;">New Types<br><span style="font-size:10px;color:#999;">IFC types added</span></th>';
                    }
                    if (underObjects.length > 0) {
                        content += '<th style="text-align:center;">Improves<br><span style="font-size:10px;color:#999;">under-specified objects</span></th>';
                    }
                    content += '<th style="text-align:center;">IFC Types<br><span style="font-size:10px;color:#999;">covered by UC</span></th>';
                    content += '<th style="text-align:center;">G/A/D Match<br><span style="font-size:10px;color:#999;">profile similarity</span></th>';
                    content += '</tr></thead><tbody>';
                    matches.forEach(r => {
                        const hasAction = r.newCount > 0 || r.improvesCount > 0;
                        const rowBg = hasAction ? '#e8f5e9' : '#fff';
                        const simBar = `<div style="background:#ecf0f1;border-radius:3px;height:6px;margin-top:3px;"><div style="background:#9b59b6;height:6px;border-radius:3px;width:${r.gadSim}%;"></div></div>`;
                        content += `<tr onclick="toggle('${r.name.replace(/'/g,"\\'")}')" style="background:${rowBg};">`;
                        content += `<td style="font-weight:600;">${r.name}</td>`;
                        if (!allTypesCovered) {
                            const newLabel = r.newCount > 0 ? '<span style="color:#2e7d32;font-weight:700;">+' + r.newCount + '</span><br><span style="font-size:9px;color:#666;">' + r.newTypes.join(', ') + '</span>' : '<span style="color:#bdc3c7;">—</span>';
                            content += `<td style="text-align:center;">${newLabel}</td>`;
                        }
                        if (underObjects.length > 0) {
                            const impLabel = r.improvesCount > 0 ? '<span style="color:#1565c0;font-weight:700;">↑ ' + r.improvesCount + '</span><br><span style="font-size:9px;color:#666;">' + r.improvesNames.join(', ') + '</span>' : '<span style="color:#bdc3c7;">—</span>';
                            content += `<td style="text-align:center;">${impLabel}</td>`;
                        }
                        content += `<td style="text-align:center;">${r.coversCount} / ${ifcObjectNames.size}</td>`;
                        content += `<td style="text-align:center;">${r.gadSim}%${simBar}</td>`;
                        content += '</tr>';
                    });
                    content += '</tbody></table></div>';
                } else {
                    // Original Top Additions (no IFC loaded)
                    const recs = uns.map(uc => ({name:uc.name, marginal:INCREMENTAL[uc.name]?.marginal||0, unique:INCREMENTAL[uc.name]?.unique||0, tier:getTier(INCREMENTAL[uc.name]?.marginal||0)})).sort((a,b) => b.marginal-a.marginal);
                    content += '<div style="margin-top:30px;"><div class="chart-title">Top Additions</div><table class="rec-table"><thead><tr><th>Use Case</th><th>Marginal</th><th>Uniqueness</th><th>Tier</th></tr></thead><tbody>';
                    recs.slice(0,10).forEach(r => {
                        content += `<tr onclick="toggle('${r.name.replace(/'/g,"\\'")}')"><td>${r.name}</td><td style="font-weight:700;color:#5568d3;">+${r.marginal}</td><td>${r.unique}%</td><td><span class="badge badge-${r.tier.label.toLowerCase().replace(' ','-')}">${r.tier.label}</span></td></tr>`;
                    });
                    content += '</tbody></table></div>';
                }
                }

                // IFC Object-level analysis with coverage tracking (shown above BIMids table when IFC loaded)
                if (ifcData && ifcData.objectKPIs.length > 0) {
                    // Determine which IFC objects are covered by selected use cases
                    const coveredSet = new Set();
                    if (selected.length > 0) {
                        for (const [objName, purposes] of Object.entries(OBJECT_PURPOSE_MAP)) {
                            if (purposes.some(p => selected.includes(p))) {
                                coveredSet.add(objName);
                            }
                        }
                    }
                    const covCount = ifcData.objectKPIs.filter(o => coveredSet.has(o.name)).length;
                    const totalIfcTypes = ifcData.objectKPIs.length;
                    const covLabel = selected.length === 0
                        ? '— select use cases to track coverage'
                        : covCount === totalIfcTypes
                            ? '<span style="color:#2e7d32;">✓ All covered</span>'
                            : '<span style="color:#e65100;">' + covCount + ' / ' + totalIfcTypes + ' covered</span>';

                    content += '<div style="margin-top:30px;"><div class="chart-title" style="color:#27ae60;">IFC Object-Level Analysis (' + totalIfcTypes + ' object types) ' + covLabel + '</div>';
                    content += '<table class="rec-table"><thead><tr>';
                    if (selected.length > 0) content += '<th style="text-align:center;width:40px;">IDS</th>';
                    content += '<th>Object Type</th>';
                    content += '<th style="text-align:center;">Instances</th>';
                    content += '<th style="text-align:center;">Total Reqs</th>';
                    content += '<th style="text-align:center;">Intensity<br><span style="font-size:10px;color:#999;">(unique reqs)</span></th>';
                    content += '<th style="text-align:center;">G %</th>';
                    content += '<th style="text-align:center;">A %</th>';
                    content += '</tr></thead><tbody>';
                    ifcData.objectKPIs.forEach(o => {
                        const isCovered = coveredSet.has(o.name);
                        const rowStyle = isCovered && selected.length > 0
                            ? 'opacity:0.4;'
                            : '';
                        const intBg = o.intensity > 10 ? '#e8f5e9' : o.intensity > 5 ? '#f1f8e9' : '#f8f9fa';
                        const intColor = o.intensity > 10 ? '#1b5e20' : o.intensity > 5 ? '#33691e' : '#555';
                        content += `<tr style="${rowStyle}">`;
                        if (selected.length > 0) {
                            content += `<td style="text-align:center;font-size:14px;">${isCovered ? '✓' : '✗'}</td>`;
                        }
                        content += `<td style="font-weight:600;">${o.name}</td>`;
                        content += `<td style="text-align:center;">${o.count}</td>`;
                        content += `<td style="text-align:center;font-weight:600;">${o.reqs}</td>`;
                        content += `<td style="text-align:center;background:${intBg};font-weight:700;color:${intColor};">${o.intensity.toFixed(1)}</td>`;
                        content += `<td style="text-align:center;">${o.compG.toFixed(1)}%</td>`;
                        content += `<td style="text-align:center;">${o.compA.toFixed(1)}%</td>`;
                        content += '</tr>';
                    });
                    content += '</tbody></table></div>';

                    if (ifcData.unmappedCount > 0) {
                        const topUnmapped = Object.entries(ifcData.unmappedTypes).sort((a,b) => b[1]-a[1]).slice(0,10);
                        content += '<div style="margin-top:15px;padding:12px;background:#fff8e1;border-radius:8px;font-size:12px;">';
                        content += '<strong style="color:#e65100;">⚠ ' + ifcData.unmappedCount + ' entities not mapped to BIMids objects:</strong> ';
                        content += topUnmapped.map(([t,c]) => t + ' (' + c + ')').join(', ');
                        if (Object.keys(ifcData.unmappedTypes).length > 10) content += ', ...';
                        content += '</div>';
                    }
                }

                // Object-level comparison or BIMids-only table
                if (selected.length > 0) {
                const objK = getObjectKPIs();

                if (ifcData && objK.length > 0) {
                    // === MERGED IFC vs IDS COMPARISON TABLE ===
                    // For each IFC object type, show IFC data alongside IDS requirements
                    const idsMap = {};
                    objK.forEach(o => { idsMap[o.name] = o; });

                    // Build unified list: all IFC objects + any IDS-only objects
                    const allObjects = [];
                    const seen = new Set();
                    // IFC objects first
                    ifcData.objectKPIs.forEach(o => {
                        seen.add(o.name);
                        allObjects.push({
                            name: o.name,
                            inIfc: true, inIds: !!idsMap[o.name],
                            ifcIntensity: o.intensity, ifcG: o.compG, ifcA: o.compA, ifcCount: o.count,
                            idsIntensity: idsMap[o.name]?.intensity || 0,
                            idsG: idsMap[o.name]?.compG || 0, idsA: idsMap[o.name]?.compA || 0,
                            idsPurposes: idsMap[o.name]?.purposeCount || 0
                        });
                    });
                    // IDS-only objects (not in IFC)
                    objK.forEach(o => {
                        if (!seen.has(o.name)) {
                            allObjects.push({
                                name: o.name,
                                inIfc: false, inIds: true,
                                ifcIntensity: 0, ifcG: 0, ifcA: 0, ifcCount: 0,
                                idsIntensity: o.intensity,
                                idsG: o.compG, idsA: o.compA,
                                idsPurposes: o.purposeCount
                            });
                        }
                    });

                    // Sort: IFC objects with IDS match first (by gap), then IFC-only, then IDS-only
                    allObjects.sort((a, b) => {
                        const aScore = (a.inIfc && a.inIds) ? 2 : a.inIfc ? 1 : 0;
                        const bScore = (b.inIfc && b.inIds) ? 2 : b.inIfc ? 1 : 0;
                        if (bScore !== aScore) return bScore - aScore;
                        return b.ifcIntensity - a.ifcIntensity;
                    });

                    content += '<div style="margin-top:30px;"><div class="chart-title">IFC vs IDS Object Comparison</div>';
                    content += '<div style="font-size:11px;color:#7f8c8d;margin-bottom:10px;">Per-object comparison of IFC model data vs selected IDS requirements</div>';
                    content += '<table class="rec-table"><thead><tr>';
                    content += '<th>Object</th>';
                    content += '<th style="text-align:center;">Status</th>';
                    content += '<th style="text-align:center;">IFC<br><span style="font-size:10px;color:#27ae60;">intensity</span></th>';
                    content += '<th style="text-align:center;">IDS<br><span style="font-size:10px;color:#667eea;">intensity</span></th>';
                    content += '<th style="text-align:center;">Gap</th>';
                    content += '<th style="text-align:center;">IFC G/A<br><span style="font-size:10px;color:#27ae60;">%</span></th>';
                    content += '<th style="text-align:center;">IDS G/A<br><span style="font-size:10px;color:#667eea;">%</span></th>';
                    content += '</tr></thead><tbody>';

                    allObjects.forEach(o => {
                        let badge, badgeCls, rowBg;
                        if (!o.inIfc) {
                            badge = 'Not in IFC'; badgeCls = 'badge-minimal'; rowBg = '#f8f8f8';
                        } else if (!o.inIds) {
                            badge = 'No IDS'; badgeCls = 'badge-low'; rowBg = '#fff8e1';
                        } else {
                            const gap = o.ifcIntensity - o.idsIntensity;
                            if (gap >= 2) { badge = 'Over'; badgeCls = 'badge-high'; rowBg = '#e3f2fd'; }
                            else if (gap >= -1) { badge = 'Match'; badgeCls = 'badge-top-tier'; rowBg = '#e8f5e9'; }
                            else { badge = 'Under'; badgeCls = 'badge-moderate'; rowBg = '#fff3e0'; }
                        }

                        const gapVal = o.inIfc && o.inIds ? o.ifcIntensity - o.idsIntensity : null;
                        const gapStr = gapVal !== null
                            ? (gapVal > 0 ? '<span style="color:#2e7d32;">+' + gapVal.toFixed(1) + '</span>' : gapVal < 0 ? '<span style="color:#e65100;">' + gapVal.toFixed(1) + '</span>' : '<span style="color:#7f8c8d;">0</span>')
                            : '<span style="color:#bdc3c7;">—</span>';

                        content += `<tr style="background:${rowBg};">`;
                        content += `<td style="font-weight:600;">${o.name}${o.inIfc ? '<br><span style=\"font-size:10px;color:#999;\">' + o.ifcCount + ' instances</span>' : ''}</td>`;
                        content += `<td style="text-align:center;"><span class="badge ${badgeCls}">${badge}</span></td>`;
                        content += `<td style="text-align:center;font-weight:700;color:#27ae60;">${o.inIfc ? o.ifcIntensity.toFixed(1) : '—'}</td>`;
                        content += `<td style="text-align:center;font-weight:700;color:#667eea;">${o.inIds ? o.idsIntensity.toFixed(1) : '—'}</td>`;
                        content += `<td style="text-align:center;font-weight:700;">${gapStr}</td>`;
                        content += `<td style="text-align:center;">${o.inIfc ? o.ifcG.toFixed(0) + '% / ' + o.ifcA.toFixed(0) + '%' : '—'}</td>`;
                        content += `<td style="text-align:center;">${o.inIds ? o.idsG.toFixed(0) + '% / ' + o.idsA.toFixed(0) + '%' : '—'}</td>`;
                        content += '</tr>';
                    });
                    content += '</tbody></table></div>';

                } else if (objK.length > 0) {
                    // BIMids-only table (no IFC loaded)
                    content += '<div style="margin-top:30px;"><div class="chart-title">BIMids Object-Level Analysis (' + objK.length + ' objects in selected purposes)</div>';
                    content += '<table class="rec-table"><thead><tr>';
                    content += '<th>Object</th>';
                    content += '<th style="text-align:center;">Purpose Count<br><span style="font-size:10px;color:#999;">(Nₒ)</span></th>';
                    content += '<th style="text-align:center;">Cumulative Reqs<br><span style="font-size:10px;color:#999;">(Rₒ)</span></th>';
                    content += '<th style="text-align:center;">Intensity<br><span style="font-size:10px;color:#999;">(ρₒ)</span></th>';
                    content += '<th style="text-align:center;">Component %<br><span style="font-size:10px;color:#999;">(G / A)</span></th>';
                    content += '<th style="text-align:center;">Phase Coverage<br><span style="font-size:10px;color:#999;">(Φₒ)</span></th>';
                    content += '</tr></thead><tbody>';
                    objK.forEach(o => {
                        const intBg = o.intensity > 10 ? '#ffebee' : o.intensity > 8 ? '#fff3e0' : '#f8f9fa';
                        const intColor = o.intensity > 10 ? '#c62828' : o.intensity > 8 ? '#e65100' : '#555';
                        content += `<tr><td style="font-weight:600;">${o.name}</td>`;
                        content += `<td style="text-align:center;">${o.purposeCount}</td>`;
                        content += `<td style="text-align:center;font-weight:600;">${o.cumulativeReqs}</td>`;
                        content += `<td style="text-align:center;background:${intBg};font-weight:700;font-size:14px;color:${intColor};">${o.intensity.toFixed(1)}</td>`;
                        content += `<td style="text-align:center;">${o.compG.toFixed(0)}% / ${o.compA.toFixed(0)}%</td>`;
                        content += `<td style="text-align:center;">${o.phaseCoverage}/5</td>`;
                        content += '</tr>';
                    });
                    content += '</tbody></table></div>';
                }
                }
            }
            app.innerHTML = `<div class="container"><div class="header"><h1>BIMids Selection Dashboard</h1><p>Interactive LOIN Analysis - Build your configuration, upload IFC models, and compare</p></div><div class="main"><div class="sidebar">${sidebar}</div><div class="content">${content}</div></div></div>`;

            // Attach IFC file handlers after DOM update
            setTimeout(() => {
                const dropZone = document.getElementById('ifc-drop-zone');
                const fileInput = document.getElementById('ifc-file-input');
                if (dropZone) {
                    dropZone.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('dragover'); });
                    dropZone.addEventListener('dragleave', () => { dropZone.classList.remove('dragover'); });
                    dropZone.addEventListener('drop', (e) => { e.preventDefault(); dropZone.classList.remove('dragover'); if (e.dataTransfer.files[0]) handleIfcUpload(e.dataTransfer.files[0]); });
                }
                if (fileInput) {
                    fileInput.addEventListener('change', (e) => { if (e.target.files[0]) handleIfcUpload(e.target.files[0]); });
                }
            }, 10);

            // Chart rendering
            setTimeout(() => {
                // BIMids-only doughnut
                const cc = document.getElementById('compChart');
                if (cc && selected.length > 0) {
                    if (window.cChart) window.cChart.destroy();
                    window.cChart = new Chart(cc, {
                        type:'doughnut', 
                        data:{
                            labels:['Geometrical','Alphanumerical','Documentation'], 
                            datasets:[{
                                data:[m.totalGeom,m.totalProps,m.totalDocs], 
                                backgroundColor:['#42a5f5','#66bb6a','#ffa726']
                            }]
                        }, 
                        options:{
                            responsive:true, maintainAspectRatio:false, 
                            plugins:{
                                legend:{ position:'bottom', labels:{ generateLabels: function(chart) { const data = chart.data; const total = data.datasets[0].data.reduce((a,b) => a+b, 0); return data.labels.map((label, i) => { const value = data.datasets[0].data[i]; const pct = total>0?((value/total)*100).toFixed(1):'0'; return { text: label + ': ' + value + ' (' + pct + '%)', fillStyle: data.datasets[0].backgroundColor[i], hidden: false, index: i }; }); } } },
                                tooltip:{ callbacks:{ label: function(context) { const value = context.parsed; const total = context.dataset.data.reduce((a,b) => a+b, 0); const pct = total>0?((value/total)*100).toFixed(1):'0'; return context.label + ': ' + value + ' (' + pct + '%)'; } } }
                            }
                        }
                    });
                }

                // Comparison doughnut (BIMids vs IFC side by side in one chart)
                const compCompare = document.getElementById('compCompareChart');
                if (compCompare && ifcData && selected.length > 0) {
                    if (window.ccChart) window.ccChart.destroy();
                    const bT = m.totalGeom + m.totalProps + m.totalDocs;
                    const iN = ifcData.normScore;
                    window.ccChart = new Chart(compCompare, {
                        type:'bar',
                        data:{
                            labels:['Geometrical (G)', 'Alphanumerical (A)', 'Documentation (D)'],
                            datasets:[
                                { label:'BIMids', data:[bT>0?m.totalGeom/bT*100:0, bT>0?m.totalProps/bT*100:0, bT>0?m.totalDocs/bT*100:0], backgroundColor:'rgba(102,126,234,0.7)', borderColor:'#667eea', borderWidth:1 },
                                { label:'IFC', data:[iN>0?ifcData.normGeom/iN*100:0, iN>0?ifcData.normProps/iN*100:0, iN>0?ifcData.normDocs/iN*100:0], backgroundColor:'rgba(39,174,96,0.7)', borderColor:'#27ae60', borderWidth:1 }
                            ]
                        },
                        options:{
                            responsive:true, maintainAspectRatio:false,
                            scales:{ y:{beginAtZero:true, max:100, title:{display:true, text:'%'}, ticks:{callback:(v) => v + '%'}} },
                            plugins:{ legend:{position:'bottom'}, tooltip:{callbacks:{label: function(ctx){ return ctx.dataset.label + ': ' + ctx.parsed.y.toFixed(1) + '%'; }}} }
                        }
                    });
                }

                // IFC-only doughnut
                const ifcOnlyComp = document.getElementById('ifcOnlyCompChart');
                if (ifcOnlyComp && ifcData) {
                    if (window.ifcOChart) window.ifcOChart.destroy();
                    window.ifcOChart = new Chart(ifcOnlyComp, {
                        type:'doughnut',
                        data:{
                            labels:['Geometrical','Alphanumerical','Documentation'],
                            datasets:[{ data:[ifcData.totalGeom, ifcData.totalProps, ifcData.totalDocs], backgroundColor:['#66bb6a','#26a69a','#ffa726'] }]
                        },
                        options:{
                            responsive:true, maintainAspectRatio:false,
                            plugins:{
                                legend:{ position:'bottom', labels:{ generateLabels: function(chart) { const data = chart.data; const total = data.datasets[0].data.reduce((a,b) => a+b, 0); return data.labels.map((label, i) => { const value = data.datasets[0].data[i]; const pct = total>0?((value/total)*100).toFixed(1):'0'; return { text: label + ': ' + value + ' (' + pct + '%)', fillStyle: data.datasets[0].backgroundColor[i], hidden: false, index: i }; }); } } },
                                tooltip:{ callbacks:{ label: function(context) { const value = context.parsed; const total = context.dataset.data.reduce((a,b) => a+b, 0); const pct = total>0?((value/total)*100).toFixed(1):'0'; return context.label + ': ' + value + ' (' + pct + '%)'; } } }
                            }
                        }
                    });
                }

                // IFC object bar chart
                const ifcObjBar = document.getElementById('ifcObjectBarChart');
                if (ifcObjBar && ifcData) {
                    if (window.ifcObjChart) window.ifcObjChart.destroy();
                    const top15 = ifcData.objectKPIs.sort((a,b) => b.count - a.count).slice(0,15);
                    window.ifcObjChart = new Chart(ifcObjBar, {
                        type:'bar',
                        data:{
                            labels: top15.map(o => o.name),
                            datasets:[{ label:'Instances', data: top15.map(o => o.count), backgroundColor:'rgba(39,174,96,0.6)', borderColor:'#27ae60', borderWidth:1 }]
                        },
                        options:{
                            responsive:true, maintainAspectRatio:false, indexAxis:'y',
                            scales:{ x:{beginAtZero:true} },
                            plugins:{ legend:{display:false} }
                        }
                    });
                }

                // Phase chart (BIMids only, shown in both BIMids-only and comparison modes)
                const pc = document.getElementById('phaseChart');
                if (pc && selected.length > 0) {
                    if (window.pChart) window.pChart.destroy();
                    window.pChart = new Chart(pc, {
                        type:'bar',
                        data:{
                            labels:['Phase 1 (PD)\nRIBA 0-2','Phase 2 (FD/AUT)\nRIBA 3-4','Phase 3 (FP/TEND)\nRIBA 4-5','Phase 4 (EXE/ASB)\nRIBA 5','Phase 5 (OPE)\nRIBA 6-7'],
                            datasets:[{ data:m.phases, backgroundColor:['#e3f2fd','#90caf9','#42a5f5','#1e88e5','#0d47a1'] }]
                        },
                        options:{
                            responsive:true, maintainAspectRatio:false,
                            scales:{ y:{beginAtZero:true, max:100, title:{display:true, text:'Percentage (%)'}, ticks:{callback:(v) => v + '%'}}, x:{ticks:{font:{size:9}}} },
                            plugins:{legend:{display:false}}
                        }
                    });
                }
            }, 50);
        }
        
        console.log('Dashboard ready');
        render();
    </script>
</body>
</html>
