<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>BIMids Dashboard</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif; background: #f5f7fa; }
        .container { max-width: 1400px; margin: 0 auto; padding: 20px; }
        .header { text-align: center; margin-bottom: 30px; background: linear-gradient(135deg, #667eea, #764ba2); padding: 40px 20px; border-radius: 12px; box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3); }
        .header h1 { font-size: 32px; color: white; margin-bottom: 10px; }
        .header p { color: rgba(255,255,255,0.95); font-size: 16px; }
        .main { display: grid; grid-template-columns: 300px 1fr; gap: 20px; }
        .sidebar { background: white; border-radius: 12px; padding: 20px; height: fit-content; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
        .sidebar h2 { font-size: 18px; margin-bottom: 15px; }
        .quick-actions { display: flex; gap: 8px; margin-bottom: 15px; }
        .btn { padding: 8px 12px; border: none; border-radius: 6px; font-size: 12px; cursor: pointer; font-weight: 600; }
        .btn-reset { background: #e74c3c; color: white; }
        .btn-quick { background: #3498db; color: white; }
        .use-case-card { padding: 12px; margin-bottom: 8px; border: 2px solid #ecf0f1; border-radius: 8px; cursor: pointer; }
        .use-case-card:hover { border-color: #3498db; }
        .use-case-card.selected { background: #e8f4f8; border-color: #3498db; }
        .use-case-card.baseline { border-color: #9b59b6; background: #f4ecf7; }
        .card-header { display: flex; align-items: center; gap: 8px; }
        .card-name { flex: 1; font-size: 13px; font-weight: 500; }
        .card-score { font-size: 12px; font-weight: 700; color: #7f8c8d; }
        .card-meta { font-size: 11px; color: #95a5a6; margin-top: 4px; margin-left: 24px; }
        .divider { height: 1px; background: #ecf0f1; margin: 12px 0; }
        .section-header { font-size: 11px; font-weight: 700; color: #7f8c8d; margin: 12px 0 8px; text-transform: uppercase; }
        .content { background: white; border-radius: 12px; padding: 30px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
        .empty-state { text-align: center; padding: 100px 20px; color: #95a5a6; font-size: 18px; }
        .metrics { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 30px; }
        .metric { background: linear-gradient(135deg, #667eea, #764ba2); color: white; padding: 20px; border-radius: 10px; }
        .metric-label { font-size: 12px; opacity: 0.9; margin-bottom: 8px; }
        .metric-value { font-size: 30px; font-weight: 700; }
        .metric-sub { font-size: 11px; margin-top: 5px; opacity: 0.8; }
        .object-cards { display: grid; grid-template-columns: repeat(5, 1fr); gap: 15px; margin-bottom: 30px; }
        .object-card { padding: 18px; border-radius: 10px; }
        .object-card-name { font-size: 11px; opacity: 0.9; margin-bottom: 6px; font-weight: 600; }
        .object-card-value { font-size: 26px; font-weight: 700; margin-bottom: 8px; }
        .object-card-label { font-size: 10px; opacity: 0.85; }
        .object-card-details { font-size: 9px; opacity: 0.8; margin-top: 8px; border-top: 1px solid rgba(255,255,255,0.3); padding-top: 6px; }
        .charts { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 30px; }
        .chart-box { border: 1px solid #ecf0f1; border-radius: 10px; padding: 20px; }
        .chart-title { font-size: 15px; font-weight: 600; margin-bottom: 15px; }
        .chart-canvas { height: 300px; }
        .rec-table { width: 100%; border-collapse: collapse; font-size: 13px; }
        .rec-table th { background: #f8f9fa; padding: 12px; text-align: left; font-weight: 600; border-bottom: 2px solid #dee2e6; }
        .rec-table td { padding: 12px; border-bottom: 1px solid #ecf0f1; }
        .rec-table tr:hover { background: #f8f9fa; cursor: pointer; }
        .badge { padding: 4px 8px; border-radius: 4px; font-size: 11px; font-weight: 600; }
        .badge-top-tier { background: #27ae60; color: white; }
        .badge-high { background: #3498db; color: white; }
        .badge-moderate { background: #f39c12; color: white; }
        .badge-low { background: #95a5a6; color: white; }
        .badge-minimal { background: #bdc3c7; color: white; }
        .ifc-upload-area { border: 2px dashed #3498db; border-radius: 10px; padding: 15px; text-align: center; margin-bottom: 15px; cursor: pointer; transition: all 0.2s; background: #f8fbff; }
        .ifc-upload-area:hover { background: #e8f4f8; border-color: #2980b9; }
        .ifc-upload-area.dragover { background: #d5edfa; border-color: #2980b9; }
        .ifc-upload-area.loaded { border-color: #27ae60; background: #f0faf4; }
        .ifc-upload-icon { font-size: 24px; margin-bottom: 5px; }
        .ifc-upload-text { font-size: 12px; color: #7f8c8d; }
        .ifc-upload-file { font-size: 11px; color: #27ae60; font-weight: 600; margin-top: 4px; }
        .ifc-status { font-size: 11px; padding: 6px 10px; border-radius: 6px; margin-bottom: 10px; }
        .ifc-status.parsing { background: #fff3e0; color: #e65100; }
        .ifc-status.done { background: #e8f5e9; color: #2e7d32; }
        .ifc-status.error { background: #ffebee; color: #c62828; }
        .comparison-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 30px; }
        .comparison-panel { border: 2px solid #ecf0f1; border-radius: 10px; padding: 20px; }
        .comparison-panel.bimids-panel { border-color: #667eea; }
        .comparison-panel.ifc-panel { border-color: #27ae60; }
        .comparison-panel-title { font-size: 14px; font-weight: 700; margin-bottom: 15px; display: flex; align-items: center; gap: 8px; }
        .comparison-panel-title .dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
        .dot-bimids { background: #667eea; }
        .dot-ifc { background: #27ae60; }
        .comp-metric { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #f0f0f0; font-size: 13px; }
        .comp-metric-label { color: #7f8c8d; }
        .comp-metric-value { font-weight: 700; }
        .comp-bar { height: 8px; border-radius: 4px; background: #ecf0f1; margin-top: 4px; overflow: hidden; }
        .comp-bar-fill { height: 100%; border-radius: 4px; transition: width 0.4s ease; }
        .ifc-clear-btn { background: none; border: 1px solid #e74c3c; color: #e74c3c; padding: 4px 8px; border-radius: 4px; font-size: 10px; cursor: pointer; margin-left: 8px; }
        .ifc-clear-btn:hover { background: #e74c3c; color: white; }
    </style>
</head>
